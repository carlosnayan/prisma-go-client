
type QueryResult struct {
	rows Rows
	err  error
}

func (r *QueryResult) Scan(dest interface{}) error {
	if r.err != nil {
		return r.err
	}
	if r.rows == nil {
		return fmt.Errorf("QueryResult.Scan: no rows to scan")
	}
	defer r.rows.Close()

	destVal := reflect.ValueOf(dest)
	if destVal.Kind() != reflect.Ptr {
		return fmt.Errorf("QueryResult.Scan: dest must be a pointer")
	}

	elemVal := destVal.Elem()
	switch elemVal.Kind() {
	case reflect.Slice:
		return scanRows(r.rows, dest)
	case reflect.Struct:
		return scanRow(r.rows, dest)
	default:
		// Assume primitive
		return scanPrimitive(r.rows, dest)
	}
}

func (r *QueryResult) Rows() (Rows, error) {
	return r.rows, r.err
}

func scanRows(rows Rows, dest interface{}) error {
	destVal := reflect.ValueOf(dest)
	sliceVal := destVal.Elem()
	elemType := sliceVal.Type().Elem()
	
	isPtr := elemType.Kind() == reflect.Ptr
	if isPtr {
		elemType = elemType.Elem()
	}
	
	if elemType.Kind() != reflect.Struct {
		return fmt.Errorf("QueryResult.Scan: slice element must be a struct or pointer to struct")
	}
	
	columns, err := rows.Columns()
	if err != nil {
		return fmt.Errorf("failed to get columns: %w", err)
	}
	
	fieldMap := buildFieldMap(elemType)
	count := 0
	
	for rows.Next() {
		count++
		elemPtr := reflect.New(elemType)
		elem := elemPtr.Elem()
		
		scanDest := make([]interface{}, len(columns))
		for i, col := range columns {
			colName := extractColumnName(col)
			if fieldIdx, ok := fieldMap[colName]; ok {
				scanDest[i] = elem.Field(fieldIdx).Addr().Interface()
			} else {
				var discard interface{}
				scanDest[i] = &discard
			}
		}
		
		if err := rows.Scan(scanDest...); err != nil {
			return fmt.Errorf("failed to scan row: %w", err)
		}
		
		if isPtr {
			sliceVal.Set(reflect.Append(sliceVal, elemPtr))
		} else {
			sliceVal.Set(reflect.Append(sliceVal, elem))
		}
	}
	
	if err := rows.Err(); err != nil {
		return fmt.Errorf("rows error: %w", err)
	}
	
	// Initialize empty slice instead of nil
	if count == 0 && sliceVal.IsNil() {
		sliceVal.Set(reflect.MakeSlice(sliceVal.Type(), 0, 0))
	}
	
	return nil
}

func scanRow(rows Rows, dest interface{}) error {
	columns, err := rows.Columns()
	if err != nil {
		return fmt.Errorf("failed to get columns: %w", err)
	}

	if !rows.Next() {
		return fmt.Errorf("QueryResult.Scan: no rows found")
	}

	destVal := reflect.ValueOf(dest)
	elemVal := destVal.Elem()
	fieldMap := buildFieldMap(elemVal.Type())
	
	scanDest := make([]interface{}, len(columns))
	for i, col := range columns {
		colName := extractColumnName(col)
		if fieldIdx, ok := fieldMap[colName]; ok {
			scanDest[i] = elemVal.Field(fieldIdx).Addr().Interface()
		} else {
			var discard interface{}
			scanDest[i] = &discard
		}
	}
	
	if err := rows.Scan(scanDest...); err != nil {
		return fmt.Errorf("failed to scan row: %w", err)
	}

	if rows.Next() {
		return fmt.Errorf("QueryResult.Scan: expected exactly 1 row, but query returned more")
	}

	return rows.Err()
}

func scanPrimitive(rows Rows, dest interface{}) error {
	columns, err := rows.Columns()
	if err != nil {
		return fmt.Errorf("failed to get columns: %w", err)
	}

	if len(columns) != 1 {
		return fmt.Errorf("QueryResult.Scan: expected exactly 1 column for primitive scan, but got %d", len(columns))
	}

	if !rows.Next() {
		return fmt.Errorf("QueryResult.Scan: no rows found")
	}

	if err := rows.Scan(dest); err != nil {
		return fmt.Errorf("failed to scan primitive: %w", err)
	}

	if rows.Next() {
		return fmt.Errorf("QueryResult.Scan: expected exactly 1 row for primitive scan, but query returned more")
	}

	return rows.Err()
}

func buildFieldMap(t reflect.Type) map[string]int {
	fieldMap := make(map[string]int)
	for i := 0; i < t.NumField(); i++ {
		field := t.Field(i)
		
		// Priority 1: db tag
		tag := field.Tag.Get("db")
		if tag == "-" {
			continue
		}
		if tag != "" {
			fieldMap[tag] = i
			continue
		}

		// Priority 2: json tag (fallback)
		tag = field.Tag.Get("json")
		if tag != "" && tag != "-" {
			// Strip json options like "omitempty"
			if idx := strings.Index(tag, ","); idx != -1 {
				tag = tag[:idx]
			}
			fieldMap[tag] = i
		}
	}
	return fieldMap
}

func extractColumnName(col string) string {
	col = strings.TrimSpace(col)
	lowerCol := strings.ToLower(col)
	if idx := strings.LastIndex(lowerCol, " as "); idx != -1 {
		return strings.TrimSpace(col[idx+4:])
	}
	if idx := strings.LastIndex(col, "."); idx != -1 {
		return col[idx+1:]
	}
	return col
}
