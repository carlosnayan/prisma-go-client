// Nullable wrapper types for handling explicit NULL values

// skipJSONType is a marker type for fields that should be omitted during JSON marshaling
type skipJSONType struct{}

// MarshalJSON for skipJSONType returns an error that json.Marshal interprets as "skip this field"
func (skipJSONType) MarshalJSON() ([]byte, error) {
	return []byte{}, nil
}

var skipJSON = skipJSONType{}

// NullableString provides fluent methods to handle nullable string fields
type NullableString struct {
	Value  *string
	IsSet  bool
	IsNull bool
}

// NullableStringNamespace provides fluent constructor methods for NullableString
type NullableStringNamespace struct{}

// String is the namespace for creating NullableString values
var String = NullableStringNamespace{}

// Set creates a NullableString with a non-null value
func (NullableStringNamespace) Set(v string) NullableString {
	return NullableString{Value: &v, IsSet: true, IsNull: false}
}

// SetNull creates a NullableString with an explicit null value
func (NullableStringNamespace) SetNull() NullableString {
	return NullableString{Value: nil, IsSet: true, IsNull: true}
}

// MarshalJSON implements json.Marshaler for NullableString
func (n NullableString) MarshalJSON() ([]byte, error) {
	if !n.IsSet {
		// Not set - return empty slice to signal omitempty to skip
		// This works with omitempty tag
		return []byte{}, nil
	}
	if n.IsNull {
		// Explicitly set to NULL
		return []byte("null"), nil
	}
	// Has a value
	return json.Marshal(n.Value)
}




