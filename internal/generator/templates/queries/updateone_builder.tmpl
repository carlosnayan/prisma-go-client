// Exec executes the update one operation
func (b *{{.PascalName}}UpdateOneBuilder) Exec() error {
	return b.ExecWithContext(b.query.Query.GetContext())
}

// ExecWithContext executes the update one operation with an explicit context
func (b *{{.PascalName}}UpdateOneBuilder) ExecWithContext(ctx context.Context) error {
	// Reset query state to prevent accumulation
	b.query.Query.Reset()

	if len(b.fields) == 0 {
		return fmt.Errorf("at least one field must be set for update")
	}

	// Apply ID condition
	{{if .PrimaryKey}}
	b.query.Query.Where({{printf "%q" .PrimaryKey}}+" = ?", b.id)
	{{else}}
	b.query.Query.Where("id = ?", b.id)
	{{end}}

	// Prepare update data
	updateData := make(map[string]interface{})
	for k, v := range b.fields {
		updateData[k] = v
	}

	// Execute update - Updates returns only error
	return b.query.Query.Updates(ctx, updateData)
}

